{
  "name": "homeiptv",
  "version": "main_0.11",
  "description": "A simple IPTV player with server-side storage and user authentication.",
  "workspaces": [
    "backend",
    "frontend",
    "shared/types"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=@homeiptv/backend",
    "dev:frontend": "npm run dev --workspace=@homeiptv/frontend",
    "build": "npm run build --workspaces --if-present",
    "migrate": "npm run migrate --workspace=@homeiptv/backend",
    "start": "npm run start --workspace=@homeiptv/backend",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:monit": "pm2 monit"
  },
  "author": "Andrea Ardovini",
  "license": "CC BY-NC-SA 4.0",
  "devDependencies": {
    "pm2": "^7.0.4"
  }
}