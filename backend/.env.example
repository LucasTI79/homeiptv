PORT=8999
NODE_ENV=development

# DB_CLIENT: better-sqlite3 (default, self-hosted no extra server) | pg | mysql2
DB_CLIENT=better-sqlite3

# For better-sqlite3: path to the db file.
# For pg/mysql2: a connection string, e.g. postgres://user:pass@host:5432/viniplay
DB_CONNECTION=../viniplay-data/viniplay.knex.db

# Only used by scripts/migrate-legacy-data.ts (one-off import from the old app's db)
LEGACY_SQLITE_PATH=../viniplay-data/viniplay.db
