# Copy to backend/.env and adjust. All values shown are the defaults used
# when a variable is unset (see backend/src/config/env.ts).

PORT=8999
NODE_ENV=development

# better-sqlite3 (default, no extra server needed) | pg | mysql2
DB_CLIENT=better-sqlite3

# Connection string/path for the chosen DB_CLIENT.
# - better-sqlite3: filesystem path to the .db file (default: <DATA_DIR>/homeiptv.db)
# - pg / mysql2: a full connection string, e.g. postgres://user:pass@host:5432/homeiptv
DB_CONNECTION=

# Where app data (settings.json, sources cache, logs, sqlite db) and
# recorded DVR files live. Defaults to <repo>/data and <repo>/dvr.
DATA_DIR=
DVR_DIR=

# Session cookie signing secret. If unset, one is generated and persisted to
# <DATA_DIR>/session-secret.txt on first boot -- fine for a single instance,
# but set this explicitly if you ever run more than one backend instance
# behind a load balancer (they need to share the same secret).
SESSION_SECRET=

APP_NAME=HomeIPTV
